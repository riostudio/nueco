--install.prefer-offline true
--network-timeout 600000
# EAS Build's Android image ships Node 20, but pdfjs-dist@6 (a devDependency used only by the
# local vite bundles for the web-editor/PDF-extractor webviews) declares engines >=22.13 and
# would abort `yarn install --frozen-lockfile` on the builder. The app never runs pdfjs-dist
# at runtime, so skipping the engine check is safe for builds.
--ignore-engines true
